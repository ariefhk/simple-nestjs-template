# App
PORT=3000
NODE_ENV=development
APP_NAME=Simple Nestjs Template
API_PREFIX=v1

# Swagger
SWAGGER_PATH=docs

# Logger
LOG_PATH=logs

# Redis
REDIS_URL=

# Cors
CORS_ORIGIN=*

# Cache
CACHE_TTL=60000

# Cookie
COOKIE_SECRET=

# Http
HTTP_TIMEOUT=5000
HTTP_MAX_REDIRECTS=5

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Storage
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE=5242880

# Storage - local
STORAGE_LOCAL_DIR=storage
STORAGE_LOCAL_PREFIX=/storage
STORAGE_LOCAL_BASE_URL=http://localhost:3000/storage

# Storage - s3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PUBLIC_URL=
